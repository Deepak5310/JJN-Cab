rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCustomer(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    function isDriver(driverId) {
      return isAuthenticated() && request.auth.uid == driverId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (isCustomer(userId) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid) ||
        (isAdmin() && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email)
      );
      allow delete: if false;
    }

    // Drivers collection
    match /drivers/{driverId} {
      // Read: authenticated users (customers matching rides, drivers, admins)
      allow read: if isAuthenticated();
      // Write: driver can ONLY update their own document, or Admin
      allow write: if isDriver(driverId) || isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Creation: customer can ONLY create booking if customerId matches their auth.uid, driverId is null, and status is REQUESTED
      allow create: if isAuthenticated() && 
                    request.resource.data.customerId == request.auth.uid &&
                    request.resource.data.driverId == null &&
                    request.resource.data.status == 'REQUESTED';

      // Read: Admin, Customer who owns it, assigned driver, or available drivers querying open bookings
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER']
      );

      // Update: Customer can update (e.g. cancel) or driver can accept / update progress / cancel, or Admin
      allow update: if isAuthenticated() && (
        // Admin updating / cancelling active booking while preserving customer, driver, and fare integrity
        (isAdmin() &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.driverId == resource.data.driverId &&
         request.resource.data.estimatedFare == resource.data.estimatedFare &&
         resource.data.status != 'COMPLETED') ||
        // Customer cancelling/updating their own booking (cannot set COMPLETED or change driver)
        (resource.data.customerId == request.auth.uid && 
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.driverId == resource.data.driverId &&
         resource.data.status != 'COMPLETED' &&
         (request.resource.data.status in ['CANCELLED', 'CANCELLED_BY_CUSTOMER'] ? request.resource.data.cancelledBy == request.auth.uid : true)) ||
        // Assigned driver updating trip state with valid forward transitions or cancelling
        (resource.data.driverId == request.auth.uid &&
         request.resource.data.driverId == resource.data.driverId &&
         request.resource.data.customerId == resource.data.customerId &&
         resource.data.status != 'COMPLETED' &&
         ((resource.data.status in ['ACCEPTED', 'ASSIGNED'] && request.resource.data.status in ['DRIVER_ARRIVING', 'ARRIVING']) ||
          (resource.data.status in ['DRIVER_ARRIVING', 'ARRIVING'] && request.resource.data.status in ['IN_PROGRESS', 'STARTED']) ||
          (resource.data.status in ['IN_PROGRESS', 'STARTED'] && request.resource.data.status == 'COMPLETED') ||
          (request.resource.data.status in ['CANCELLED', 'CANCELLED_BY_DRIVER'] && request.resource.data.cancelledBy == request.auth.uid))) ||
        // Unassigned driver claiming the booking
        (resource.data.driverId == null && 
         resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER'] &&
         request.resource.data.driverId == request.auth.uid &&
         request.resource.data.status == 'ACCEPTED' &&
         request.resource.data.customerId == resource.data.customerId)
      );

      // Soft deletes / cancellations only
      allow delete: if false;
    }

    // Driver live tracking collection
    match /driver_locations/{bookingId} {
      // Read: ONLY the assigned driver or assigned customer
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );

      // Write: ONLY the authenticated assigned driver
      allow write: if isAuthenticated() && 
        request.resource.data.driverId == request.auth.uid &&
        (resource == null || resource.data.driverId == request.auth.uid);
    }

    // Ratings & Reviews collection
    match /ratings/{ratingId} {
      // Read: Authenticated users
      allow read: if isAuthenticated();

      // Create: Authenticated author rating between 1 and 5 stars
      allow create: if isAuthenticated() &&
                    request.resource.data.fromUserId == request.auth.uid &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;

      // No editing or deletion of submitted reviews
      allow update, delete: if false;
    }
  }
}
