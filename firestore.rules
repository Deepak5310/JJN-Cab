rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCustomer(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    function isDriver(driverId) {
      return isAuthenticated() && request.auth.uid == driverId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isCustomer(userId);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Creation: customer can ONLY create booking if customerId matches their auth.uid
      allow create: if isAuthenticated() && 
                    request.resource.data.customerId == request.auth.uid &&
                    request.resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER'];

      // Read: Customer who owns it, assigned driver, or available drivers querying open bookings
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER']
      );

      // Update: Customer can update (e.g. cancel) or driver can accept / update progress
      allow update: if isAuthenticated() && (
        // Customer cancelling/updating their own booking
        (resource.data.customerId == request.auth.uid && 
         request.resource.data.customerId == resource.data.customerId) ||
        // Assigned driver updating trip state
        (resource.data.driverId == request.auth.uid) ||
        // Unassigned driver claiming the booking
        (resource.data.driverId == null && request.resource.data.driverId == request.auth.uid)
      );

      // Soft deletes / cancellations only
      allow delete: if false;
    }
  }
}
