rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCustomer(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    function isDriver(driverId) {
      return isAuthenticated() && request.auth.uid == driverId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isTerminalStatus(status) {
      return status in ['COMPLETED', 'CANCELLED', 'CANCELLED_BY_CUSTOMER', 'CANCELLED_BY_DRIVER', 'CANCELLED_BY_ADMIN', 'NO_DRIVERS_AVAILABLE'];
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Client creation: Never allow clients to self-assign ADMIN role
      allow create: if isAuthenticated() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == userId &&
                    request.resource.data.role in ['CUSTOMER', 'DRIVER'] &&
                    request.resource.data.isActive == true &&
                    request.resource.data.isDriverVerified == false;

      // Update: User can edit only their own permitted fields without altering role, active status, or verified status
      allow update: if isAuthenticated() && (
        (isCustomer(userId) &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isActive == resource.data.isActive &&
         request.resource.data.isDriverVerified == resource.data.isDriverVerified) ||
        (isAdmin() &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.email == resource.data.email &&
         (request.resource.data.role != 'ADMIN' || resource.data.role == 'ADMIN'))
      );

      allow delete: if false;
    }

    // Drivers collection
    match /drivers/{driverId} {
      // Read: authenticated users (customers matching rides, drivers, admins)
      allow read: if isAuthenticated();
      // Write: driver can ONLY update their own document, or Admin
      allow write: if isDriver(driverId) || isAdmin();
    }

    // Vehicles collection
    match /vehicles/{driverId} {
      // Read: authenticated users (customers matching rides, drivers, admins)
      allow read: if isAuthenticated();
      // Write: Driver can ONLY create/update their own vehicle details
      allow write: if isAuthenticated() &&
                    request.auth.uid == driverId &&
                    request.resource.data.driverId == driverId &&
                    request.resource.data.makeModel is string &&
                    request.resource.data.registrationNumber is string;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Creation: customer can ONLY create booking if customerId matches their auth.uid, driverId is null, and status is REQUESTED
      allow create: if isAuthenticated() && 
                    request.resource.data.customerId == request.auth.uid &&
                    request.resource.data.driverId == null &&
                    request.resource.data.status == 'REQUESTED';

      // Read: Admin, Customer who owns it, assigned driver, or available drivers querying open bookings
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER']
      );

      // Update: Customer can update (e.g. cancel) or driver can accept / update progress / cancel, or Admin
      allow update: if isAuthenticated() && (
        // Admin cancelling active booking before terminal state while preserving customer, driver, and fare integrity
        (isAdmin() &&
         !isTerminalStatus(resource.data.status) &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.driverId == resource.data.driverId &&
         request.resource.data.estimatedFare == resource.data.estimatedFare &&
         request.resource.data.status in ['CANCELLED', 'CANCELLED_BY_ADMIN']) ||
        // Customer cancelling their own non-terminal booking before ride start
        (resource.data.customerId == request.auth.uid && 
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.driverId == resource.data.driverId &&
         request.resource.data.estimatedFare == resource.data.estimatedFare &&
         !isTerminalStatus(resource.data.status) &&
         resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER', 'ACCEPTED', 'ASSIGNED', 'DRIVER_ARRIVING', 'ARRIVING'] &&
         request.resource.data.status in ['CANCELLED', 'CANCELLED_BY_CUSTOMER'] &&
         request.resource.data.cancelledBy == request.auth.uid) ||
        // Assigned driver updating trip state with valid forward transitions or cancelling
        (resource.data.driverId == request.auth.uid &&
         request.resource.data.driverId == resource.data.driverId &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.estimatedFare == resource.data.estimatedFare &&
         !isTerminalStatus(resource.data.status) &&
         ((resource.data.status in ['ACCEPTED', 'ASSIGNED'] && request.resource.data.status in ['DRIVER_ARRIVING', 'ARRIVING']) ||
          (resource.data.status in ['DRIVER_ARRIVING', 'ARRIVING'] && request.resource.data.status in ['IN_PROGRESS', 'STARTED']) ||
          (resource.data.status in ['IN_PROGRESS', 'STARTED'] && request.resource.data.status == 'COMPLETED') ||
          (resource.data.status in ['ACCEPTED', 'ASSIGNED', 'DRIVER_ARRIVING', 'ARRIVING', 'IN_PROGRESS', 'STARTED'] &&
           request.resource.data.status in ['CANCELLED', 'CANCELLED_BY_DRIVER'] && request.resource.data.cancelledBy == request.auth.uid))) ||
        // Unassigned driver claiming the booking
        (resource.data.driverId == null && 
         resource.data.status in ['REQUESTED', 'SEARCHING_DRIVER'] &&
         request.resource.data.driverId == request.auth.uid &&
         request.resource.data.status in ['ACCEPTED', 'ASSIGNED'] &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.estimatedFare == resource.data.estimatedFare)
      );

      // Soft deletes / cancellations only
      allow delete: if false;
    }

    // Driver live tracking collection
    match /driver_locations/{bookingId} {
      // Read: ONLY the assigned driver or assigned customer
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );

      // Write: ONLY the authenticated assigned driver
      allow write: if isAuthenticated() && 
        request.resource.data.driverId == request.auth.uid &&
        (resource == null || resource.data.driverId == request.auth.uid);

      // Delete: cleanup on ride completion or cancellation
      allow delete: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Ratings & Reviews collection
    match /ratings/{ratingId} {
      // Read: Authenticated users
      allow read: if isAuthenticated();

      // Create: Authenticated author rating between 1 and 5 stars
      allow create: if isAuthenticated() &&
                    request.resource.data.fromUserId == request.auth.uid &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;

      // No editing or deletion of submitted reviews
      allow update, delete: if false;
    }
  }
}
